classDiagram
    direction LR

    class Transport {
        <<Protocol>>
        +post(url, headers, json, timeout) dict
    }
    class StreamTransport {
        <<Protocol>>
        +stream_post(url, headers, json, timeout) Iterator~str~
    }
    class HttpxTransport

    class BaseAdapter {
        <<abstract>>
        +complete(req)*
        +parse_response(resp)*
        +stream(req) 默认实现
    }
    class OpenAIAdapter
    class AnthropicAdapter
    class MockAdapter

    class BaseChatClient {
        -BaseAdapter _adapter
        -str _model
        +send_message(...)
        +stream_message(...)
        +parse_response(...)
    }

    class ProviderRegistry {
        +register_openai(name, key, url)
        +register_anthropic(name, key, url)
        +get(name) BaseAdapter
    }
    class LLMRegistry {
        +providers / models 配置
        +文件持久化
    }

    Transport <|.. HttpxTransport
    StreamTransport <|.. HttpxTransport
    BaseAdapter <|-- OpenAIAdapter
    BaseAdapter <|-- AnthropicAdapter
    BaseAdapter <|-- MockAdapter
    BaseChatClient o-- BaseAdapter
    OpenAIAdapter ..> Transport : 注入
    AnthropicAdapter ..> Transport : 注入
    ProviderRegistry --> BaseAdapter : 按名称返回
    LLMRegistry --> ProviderRegistry
    note for BaseAdapter "stream() 有默认实现：调 complete() 包成单块返回；子类可覆写为 token 级流式"
