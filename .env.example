# NetLIVE-CoWork Configuration Example
# System environment variables take precedence over this file

# ── LLM ───────────────────────────────────────────────────────────────────
# Provider name — used when a session does not specify one
NETLIVE_COWORK_DEFAULT_LLM_PROVIDER=my-provider
NETLIVE_COWORK_DEFAULT_LLM_MODEL=gpt-4o
NETLIVE_COWORK_DEFAULT_LLM_TIMEOUT_SEC=3600
# Full provider config — bootstraps the default provider on startup (no UI registration needed).
# If the provider is already registered via the UI/storage, these values are ignored.
NETLIVE_COWORK_DEFAULT_LLM_STYLE=openai
NETLIVE_COWORK_DEFAULT_LLM_API_KEY=
NETLIVE_COWORK_DEFAULT_LLM_BASE_URL=
NETLIVE_COWORK_DEFAULT_LLM_CONTEXT_LIMIT=200000
NETLIVE_COWORK_DEFAULT_LLM_MAX_OUTPUT_TOKENS=8192

# ── Data Directories ──────────────────────────────────────────────────────
NETLIVE_COWORK_DATA_DIR=/netlive-cowork/data
NETLIVE_COWORK_SKILLS_DIR=/netlive-cowork/resources/skills
NETLIVE_COWORK_AGENTS_DIR=/netlive-cowork/resources/agents
# Base directory for resolving relative working_dir paths.
# For Docker, set this to the mount point (e.g. /workspace) and mount your projects there.
# A relative working_dir like "proj-a" will resolve to <WORKSPACE_BASE_DIR>/proj-a.
NETLIVE_COWORK_WORKSPACE_BASE_DIR=/netlive-cowork/workspace

# ── Default Agent Configuration ───────────────────────────────────────────
NETLIVE_COWORK_DEFAULT_AGENT_TEMPLATE_NAME=default
NETLIVE_COWORK_DEFAULT_PLANNER_TEMPLATE_NAME=planner

# ── Agent Loop Parameters ─────────────────────────────────────────────────
NETLIVE_COWORK_DEFAULT_TOKEN_BUDGET=20000000
NETLIVE_COWORK_DEFAULT_ROOT_MAX_TURNS=2000
NETLIVE_COWORK_DEFAULT_SUMMARY_THRESHOLD=20
NETLIVE_COWORK_DEFAULT_SHORT_WINDOW_SIZE=20

# ── Concurrency Limits ────────────────────────────────────────────────────
NETLIVE_COWORK_MAX_CONCURRENT_AGENTS=5
NETLIVE_COWORK_MAX_CONCURRENT_TASKS=10
NETLIVE_COWORK_MAX_SPAWN_DEPTH=5
NETLIVE_COWORK_MAX_RETRIES=3

# ── Tool Constraints ──────────────────────────────────────────────────────
# GTK3_BIN: Windows only. Path to GTK3 Runtime bin dir for cairosvg (local dev via uv run).
# Not needed at runtime in the packaged exe or Docker image.
# GTK3_BIN=C:\Program Files\GTK3-Runtime Win64\bin
NETLIVE_COWORK_BASH_EXEC_CWD=default
NETLIVE_COWORK_BASH_EXEC_TIMEOUT_MS=30000
NETLIVE_COWORK_BASH_EXEC_OUTPUT_LIMIT_BYTES=65536
NETLIVE_COWORK_HTTP_REQUEST_TIMEOUT_MS=10000
NETLIVE_COWORK_HTTP_RESPONSE_LIMIT_BYTES=524288
# Set to false to disable built-in tools (bash_exec, read, write, edit, glob, etc.).
# skill_executor tools and control tools are always registered regardless of this setting.
NETLIVE_COWORK_ENABLE_BUILTIN_TOOLS=true

# ── External Storage (shared backend for tools + skill semantic recall) ──
# Automatically enables tool/skill sync and semantic search when configured;
# leave empty to disable
NETLIVE_COWORK_STORE_BASE_URL=
NETLIVE_COWORK_STORE_TIMEOUT_SEC=10

# ── Logging ───────────────────────────────────────────────────────────────
NETLIVE_COWORK_LOG_LEVEL=INFO
# Log file directory. Leave empty to disable file logging.
# A new file (netlive-cowork.log) is written daily; old files are renamed to netlive-cowork.log.YYYY-MM-DD.
# Up to 30 days of files are kept.
NETLIVE_COWORK_LOG_DIR=/netlive-cowork/logs