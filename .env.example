# IPMaster-Cowork Configuration Example
# System environment variables take precedence over this file

# ── LLM ───────────────────────────────────────────────────────────────────
# Provider name — used when a session does not specify one
IPMASTER_COWORK_DEFAULT_LLM_PROVIDER=my-provider
IPMASTER_COWORK_DEFAULT_LLM_MODEL=gpt-4o
IPMASTER_COWORK_DEFAULT_LLM_TIMEOUT_SEC=3600
# Full provider config — bootstraps the default provider on startup (no UI registration needed).
# If the provider is already registered via the UI/storage, these values are ignored.
IPMASTER_COWORK_DEFAULT_LLM_STYLE=openai
IPMASTER_COWORK_DEFAULT_LLM_API_KEY=
IPMASTER_COWORK_DEFAULT_LLM_BASE_URL=
IPMASTER_COWORK_DEFAULT_LLM_CONTEXT_LIMIT=200000
IPMASTER_COWORK_DEFAULT_LLM_MAX_OUTPUT_TOKENS=8192

# ── Data Directories ──────────────────────────────────────────────────────
IPMASTER_COWORK_DATA_DIR=/ipmaster-cowork/data
IPMASTER_COWORK_SKILLS_DIR=/ipmaster-cowork/resources/skills
IPMASTER_COWORK_AGENTS_DIR=/ipmaster-cowork/resources/agents
IPMASTER_COWORK_SKILL_PULL_SERVER_URL=http://10.25.228.203:8080/api
# Base directory for resolving relative working_dir paths.
# For Docker, set this to the mount point (e.g. /workspace) and mount your projects there.
# A relative working_dir like "proj-a" will resolve to <WORKSPACE_BASE_DIR>/proj-a.
IPMASTER_COWORK_WORKSPACE_BASE_DIR=/ipmaster-cowork/workspace

# ── Default Agent Configuration ───────────────────────────────────────────
IPMASTER_COWORK_DEFAULT_AGENT_TEMPLATE_NAME=default
IPMASTER_COWORK_DEFAULT_PLANNER_TEMPLATE_NAME=planner

# ── Agent Loop Parameters ─────────────────────────────────────────────────
IPMASTER_COWORK_DEFAULT_TOKEN_BUDGET=20000000
IPMASTER_COWORK_DEFAULT_ROOT_MAX_TURNS=2000
IPMASTER_COWORK_DEFAULT_SUMMARY_THRESHOLD=20
IPMASTER_COWORK_DEFAULT_SHORT_WINDOW_SIZE=20

# ── Concurrency Limits ────────────────────────────────────────────────────
IPMASTER_COWORK_MAX_CONCURRENT_AGENTS=5
IPMASTER_COWORK_MAX_CONCURRENT_TASKS=10
IPMASTER_COWORK_MAX_SPAWN_DEPTH=5
IPMASTER_COWORK_MAX_RETRIES=3

# ── Tool Constraints ──────────────────────────────────────────────────────
# GTK3_BIN: Windows only. Path to GTK3 Runtime bin dir for cairosvg (local dev via uv run).
# Not needed at runtime in the packaged exe or Docker image.
# GTK3_BIN=C:\Program Files\GTK3-Runtime Win64\bin
IPMASTER_COWORK_BASH_EXEC_CWD=default
IPMASTER_COWORK_BASH_EXEC_TIMEOUT_MS=30000
IPMASTER_COWORK_BASH_EXEC_OUTPUT_LIMIT_BYTES=65536
IPMASTER_COWORK_HTTP_REQUEST_TIMEOUT_MS=10000
IPMASTER_COWORK_HTTP_RESPONSE_LIMIT_BYTES=524288
# Set to false to disable built-in tools (bash_exec, read, write, edit, glob, etc.).
# skill_executor tools and control tools are always registered regardless of this setting.
IPMASTER_COWORK_ENABLE_BUILTIN_TOOLS=true

# ── External Storage (shared backend for tools + skill semantic recall) ──
# Automatically enables tool/skill sync and semantic search when configured;
# leave empty to disable
IPMASTER_COWORK_STORE_BASE_URL=
IPMASTER_COWORK_STORE_TIMEOUT_SEC=10

# ── Logging ───────────────────────────────────────────────────────────────
IPMASTER_COWORK_LOG_LEVEL=INFO
# Log file directory. Leave empty to disable file logging.
# A new file (ipmaster-cowork.log) is written daily; old files are renamed to ipmaster-cowork.log.YYYY-MM-DD.
# Up to 30 days of files are kept.
IPMASTER_COWORK_LOG_DIR=/ipmaster-cowork/logs