# miniAgents Configuration Example
# System environment variables take precedence over this file

# ── LLM ───────────────────────────────────────────────────────────────────
# Provider name — used when a session does not specify one
MINIAGENTS_DEFAULT_LLM_PROVIDER=my-provider
MINIAGENTS_DEFAULT_LLM_MODEL=gpt-4o
MINIAGENTS_DEFAULT_LLM_TIMEOUT_SEC=3600
# Full provider config — bootstraps the default provider on startup (no UI registration needed).
# If the provider is already registered via the UI/storage, these values are ignored.
MINIAGENTS_DEFAULT_LLM_STYLE=openai
MINIAGENTS_DEFAULT_LLM_API_KEY=
MINIAGENTS_DEFAULT_LLM_BASE_URL=
MINIAGENTS_DEFAULT_LLM_CONTEXT_LIMIT=200000
MINIAGENTS_DEFAULT_LLM_MAX_OUTPUT_TOKENS=8192

# ── Data Directories ──────────────────────────────────────────────────────
MINIAGENTS_DATA_DIR=data
MINIAGENTS_SKILLS_DIR=resources/skills
MINIAGENTS_AGENTS_DIR=resources/agents
# Base directory for resolving relative working_dir paths.
# For Docker, set this to the mount point (e.g. /workspace) and mount your projects there.
# A relative working_dir like "proj-a" will resolve to <WORKSPACE_BASE_DIR>/proj-a.
MINIAGENTS_WORKSPACE_BASE_DIR=workspace

# ── Default Agent Configuration ───────────────────────────────────────────
MINIAGENTS_DEFAULT_AGENT_TEMPLATE_NAME=default
MINIAGENTS_DEFAULT_PLANNER_TEMPLATE_NAME=planner

# ── Agent Loop Parameters ─────────────────────────────────────────────────
MINIAGENTS_DEFAULT_TOKEN_BUDGET=20000000
MINIAGENTS_DEFAULT_ROOT_MAX_TURNS=2000
MINIAGENTS_DEFAULT_SUMMARY_THRESHOLD=20
MINIAGENTS_DEFAULT_SHORT_WINDOW_SIZE=20

# ── Concurrency Limits ────────────────────────────────────────────────────
MINIAGENTS_MAX_CONCURRENT_AGENTS=5
MINIAGENTS_MAX_CONCURRENT_TASKS=10
MINIAGENTS_MAX_SPAWN_DEPTH=5
MINIAGENTS_MAX_RETRIES=3

# ── Tool Constraints ──────────────────────────────────────────────────────
# GTK3_BIN: Windows only. Path to GTK3 Runtime bin dir for cairosvg (local dev via uv run).
# Not needed at runtime in the packaged exe or Docker image.
# GTK3_BIN=C:\Program Files\GTK3-Runtime Win64\bin
MINIAGENTS_BASH_EXEC_CWD=default
MINIAGENTS_BASH_EXEC_TIMEOUT_MS=30000
MINIAGENTS_BASH_EXEC_OUTPUT_LIMIT_BYTES=65536
MINIAGENTS_HTTP_REQUEST_TIMEOUT_MS=10000
MINIAGENTS_HTTP_RESPONSE_LIMIT_BYTES=524288
# Set to false to disable built-in tools (bash_exec, read, write, edit, glob, etc.).
# skill_executor tools and control tools are always registered regardless of this setting.
MINIAGENTS_ENABLE_BUILTIN_TOOLS=true

# ── External Storage (shared backend for tools + skill semantic recall) ──
# Automatically enables tool/skill sync and semantic search when configured;
# leave empty to disable
MINIAGENTS_STORE_BASE_URL=
MINIAGENTS_STORE_TIMEOUT_SEC=10

# ── Logging ───────────────────────────────────────────────────────────────
MINIAGENTS_LOG_LEVEL=INFO
# Log file directory. Leave empty to disable file logging.
# A new file (miniagents.log) is written daily; old files are renamed to miniagents.log.YYYY-MM-DD.
# Up to 30 days of files are kept.
MINIAGENTS_LOG_DIR=