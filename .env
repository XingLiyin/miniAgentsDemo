# miniAgents 配置文件
# 系统环境变量优先级高于此文件

# ── LLM ───────────────────────────────────────────────────────────────────
MINIAGENTS_LLM_OPENAI_API_KEY=
MINIAGENTS_LLM_OPENAI_BASE_URL=https://api.openai.com
MINIAGENTS_LLM_ANTHROPIC_API_KEY=
MINIAGENTS_LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
MINIAGENTS_LLM_DEFAULT_MODEL=gpt-4.1-mini

# ── 外部存储（工具 + Skill 语义召回后端，共用同一服务）──────────────────────
# 填写后自动启用工具/skill 同步与语义搜索；留空则禁用
MINIAGENTS_STORE_BASE_URL=
MINIAGENTS_STORE_TIMEOUT_SEC=10

# ── 日志 ──────────────────────────────────────────────────────────────────
MINIAGENTS_LOG_LEVEL=INFO
